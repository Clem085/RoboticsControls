{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Export Markdown to PDF (Puppeteer)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/export-md.ps1",
        "${file}",
        "${fileDirname}/${fileBasenameNoExtension}.pdf"
      ],
      "presentation": { "reveal": "always" },
      "problemMatcher": []
    }
  ]
}

